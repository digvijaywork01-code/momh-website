   "body": {
    "root": {
     "type": "root",
     "format": "",
     "indent": 0,
     "version": 1,
     "children": [
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Since March 2024, visitors have come to Shekhawat Haveli to follow the journey of enamelling from Renaissance Europe to the royal courts of Jaipur, and to see the art of meenakari up close. Gathered here, in their own words, are some of the reviews they have posted on Google after their visit, each shared with its author's permission.",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      }
     ],
     "direction": "ltr"
    }
   }
  },
  {
   "blockType": "divider",
   "showOn": "all",
   "desktopSpacing": "large",
   "mobileSpacing": "large"
  },
  {
   "blockType": "reviewCarousel",
   "blockName": "Visitor Reviews",
   "heading": "Visitor Reviews",
   "reviews": [
    {
     "quote": "Amazing space, beautifully curated journey of Meenakari.",
     "author": "Sandeep A.",
     "details": "review on Google, a year ago"
    },
    {
     "quote": "The place is beautiful and very peaceful and the collection is extraordinary. We have been lucky enough to benefit from a guided tour of the main pieces by a very knowledgeable and interesting member of the family owning the place. It really pays tribute to the finest Indian jewellery.",
     "author": "Marine D.",
     "details": "review on Google, 2 years ago"
    },
    {
     "quote": "An absolutely breathtaking collection. One can't miss this museum on their visit to Jaipur. The Craft of Meenakari has been beautifully curated and explained. The tour was exceptional. Everything about the museum, including the Building screams Jaipur.",
     "author": "Himashweta S.",
     "details": "review on Google, 2 years ago"
    },
    {
     "quote": "I booked an appointment to visit the museum and learn about the art of enameling. The team walked me through the space, making the experience much better. Great place to learn and appreciate this unique art form!",
     "author": "Abhilasha B.",
     "details": "review on Google, 2 years ago"
    },
    {
     "quote": "really interesting museum, makes you appreciate indian cultural work. would 100% recommend to people interested in the arts. wonderful experience with very beautiful pieces",
     "author": "Paulomi M.",
     "details": "review on Google, 2 years ago"
    },
    {
     "quote": "Great learning experience about the history of meenakari Enamelly.",
     "author": "Pradeep K.",
     "details": "review on Google, 2 years ago"
    }
   ]
  },
