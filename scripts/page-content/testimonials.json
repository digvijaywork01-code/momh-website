       "children": [
        {
         "type": "text",
         "text": "The reviews on this page are a selection of the favourable reviews that visitors have posted about the Museum on Google. We chose reviews that speak of the collection, the curation, the craft and the visit itself, and each appears only with its author's permission, in the words its author approved. The age beside each review is the one Google showed on 8 October 2026. Not every review of the Museum is praise, and you can read all of them, including those that are critical, at ",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        },
