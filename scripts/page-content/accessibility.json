     "children": [
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Everyone should be able to visit the Museum of Meenakari Heritage, at Shekhawat Haveli in Jaipur and on momhindia.org, with ease and dignity. This page says what we can offer today, what we are still working on, and how to reach us.",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      }
     ],
     "direction": "ltr"
    }
   }
  },
  {
