       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Cookies are small text files that a website stores on your device so that it can recognise your browser on later pages or visits. This page lists every cookie set when you use momhindia.org, who sets it, what it is for and how long it lasts. It should be read with our ",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        },
        {
         "type": "link",
         "version": 3,
         "id": "0e83974b131bf78704f50b0f",
         "fields": {
          "linkType": "custom",
          "url": "/privacy-policy",
          "newTab": false
         },
         "children": [
          {
           "type": "text",
           "text": "Privacy Policy",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0
        },
        {
         "type": "text",
         "text": ", which explains how we handle personal information more broadly.",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "We checked every page of this website and reviewed its code in October 2026. The cookies and services listed below are the only ones we found. momhindia.org itself stores nothing else in your browser.",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      }
     ],
     "direction": "ltr"
    }
   }
