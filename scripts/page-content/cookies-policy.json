   "body": {
    "root": {
     "type": "root",
     "format": "",
     "indent": 0,
     "version": 1,
     "children": [
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Your cookie choice",
         "format": 1,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "list",
       "listType": "bullet",
       "start": 1,
       "tag": "ul",
       "direction": "ltr",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "listitem",
         "value": 1,
         "children": [
          {
           "type": "text",
           "text": "momh-cookie-consent",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : kept in your browser's storage on momhindia.org (it is not a cookie) when you make a choice in the cookie banner, so that we do not ask again on every page. The website needs it to respect your choice, so it is set without asking. It lasts six months, after which we ask again.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        }
       ]
      },
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Visit statistics (Google Analytics)",
         "format": 1,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "paragraph",
       "format": "justify",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "These are set only if you accept analytics cookies. Until you do, Google Analytics does not run on this website.",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "list",
       "listType": "bullet",
       "start": 1,
       "tag": "ul",
       "direction": "ltr",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "listitem",
         "value": 1,
         "children": [
          {
           "type": "text",
           "text": "_ga",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : set on momhindia.org by Google Analytics. It gives your browser a random identifier, not linked to your name or contact details, so that repeat visits can be counted. Google sets it to last two years from your latest visit. When we tested it in Chrome it was set to expire after about 13 months, and some browsers clear it sooner.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        },
        {
         "type": "listitem",
         "value": 2,
         "children": [
          {
           "type": "text",
           "text": "_ga_GK6YKXRPJ8",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : set on momhindia.org by Google Analytics. It keeps track of your current browsing session for the same statistics. Same lifetime as _ga.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        }
       ]
      },
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Spam protection (Google reCAPTCHA)",
         "format": 1,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "list",
       "listType": "bullet",
       "start": 1,
       "tag": "ul",
       "direction": "ltr",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "listitem",
         "value": 1,
         "children": [
          {
           "type": "text",
           "text": "_GRECAPTCHA",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : set by Google on the google.com domain, not on momhindia.org, when reCAPTCHA runs on the ",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "link",
           "version": 3,
           "id": "7cf2ca9a0cef53ea4fb015e4",
           "fields": {
            "linkType": "custom",
            "url": "/book-an-appointment",
            "newTab": false
           },
           "children": [
            {
             "type": "text",
             "text": "Book Your Appointment",
             "format": 0,
             "style": "",
             "mode": "normal",
             "detail": 0,
             "version": 1,
             "$": {
              "color": "red"
             }
            }
           ],
           "direction": "ltr",
           "format": "",
           "indent": 0
          },
          {
           "type": "text",
           "text": " page. It helps Google tell people from automated programs. It protects the booking form, so it runs without asking. Google does not publish a fixed lifetime for it. reCAPTCHA may also keep a small record in your browser's storage on the google.com domain.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        }
       ]
      },
      {
       "type": "paragraph",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "Museum staff only",
         "format": 1,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "paragraph",
       "format": "justify",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "text",
         "text": "These are set on momhindia.org only when a member of the Museum team uses the content management system. None of them is ever set for visitors.",
         "format": 0,
         "style": "",
         "mode": "normal",
         "detail": 0,
         "version": 1
        }
       ],
       "direction": "ltr",
       "textFormat": 0,
       "textStyle": ""
      },
      {
       "type": "list",
       "listType": "bullet",
       "start": 1,
       "tag": "ul",
       "direction": "ltr",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "listitem",
         "value": 1,
         "children": [
          {
           "type": "text",
           "text": "payload-token",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : keeps a team member signed in. It expires two hours after it is set, and is renewed while they are working.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        },
        {
         "type": "listitem",
         "value": 2,
         "children": [
          {
           "type": "text",
           "text": "payload-theme",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : remembers the light or dark display a team member chose. It lasts one year.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        },
        {
         "type": "listitem",
         "value": 3,
         "children": [
          {
           "type": "text",
           "text": "payload-lng",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : remembers the language a team member chose for the management screens, if they change it. It ends when the browser is closed.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        },
        {
         "type": "listitem",
         "value": 4,
         "children": [
          {
           "type": "text",
           "text": "__prerender_bypass",
           "format": 1,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          },
          {
           "type": "text",
           "text": " : set when a signed-in team member opens a page preview from the content management system. It ends when the browser is closed.",
           "format": 0,
           "style": "",
           "mode": "normal",
           "detail": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "format": "",
         "indent": 0,
         "version": 1
        }
       ]
      }
     ],
     "direction": "ltr"
    }
   }
