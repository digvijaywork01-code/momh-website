   "items": [
    {
     "question": "Where is the museum located?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "The Museum of Meenakari Heritage is located inside Shekhawat Haveli at E141, Sardar Patel Marg, Durgadas Colony, C-Scheme, Jaipur. We are minutes from the city’s major heritage landmarks and well connected from both Jaipur Airport and the railway station.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "What are your opening hours?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "The museum is open every day, 10:00 AM to 7:30 PM. We are closed on select Indian public holidays.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Do I need to book in advance?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Yes. Entry is by prior appointment only. This allows us to keep the galleries calm and to give each visitor the attention the work deserves.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "How do I book a visit?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Please use our ",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          },
          {
           "type": "link",
           "version": 3,
           "id": "876e4ee7d3954b788a7adfbd",
           "fields": {
            "linkType": "custom",
            "url": "/book-an-appointment",
            "newTab": false
           },
           "children": [
            {
             "mode": "normal",
             "text": "Book an Appointment form",
             "type": "text",
             "style": "",
             "detail": 0,
             "format": 0,
             "version": 1
            }
           ],
           "direction": "ltr",
           "format": "",
           "indent": 0
          },
          {
           "mode": "normal",
           "text": ". Tell us a little about your visit, and our team will be in touch within 24 hours to confirm your slot.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "How long does a visit take?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Most visitors spend between 60 and 90 minutes. Private guided walkthroughs run longer, depending on your interest.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Is there an admission fee?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "There is no admission fee. Admission is by prior booking only, and is confirmed once our team has reviewed and approved your request.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    }
   ]
  },
