   "items": [
    {
     "question": "Is photography allowed inside the museum?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Photography is welcome in select zones. Flash and video are not permitted, in order to protect the works on display. Our team will guide you on arrival.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Is the museum wheelchair accessible?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Yes. The museum is fully wheelchair accessible, with ramps and elevator access throughout. If you have specific requirements, please write to us in advance.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Are guided tours available?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Yes. Private guided walkthroughs are offered at curated hours each day. Please request one at the time of booking.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "In what languages are the exhibits labelled?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "All exhibits carry bilingual labels, in English and Hindi.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Are children welcome?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Yes, we welcome thoughtful visitors of every age. We do ask that families plan ahead so younger guests can move through the galleries comfortably.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Is parking available?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "For parking and drop-off arrangements, please ",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          },
          {
           "type": "link",
           "version": 3,
           "id": "bcbe44eae3a041dfb03129c1",
           "fields": {
            "linkType": "custom",
            "url": "/contact",
            "newTab": false
           },
           "children": [
            {
             "mode": "normal",
             "text": "contact us",
             "type": "text",
