   "items": [
    {
     "question": "Can I commission a piece of jewellery?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Yes. The museum offers private consultations with our master artisans for bespoke commissions. A typical commission takes six to eight months from concept to completion. You can begin through our ",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          },
          {
           "type": "link",
           "version": 3,
           "id": "cbe21854bd974f8abf20ed68",
           "fields": {
            "linkType": "custom",
            "url": "/personal-consultation",
            "newTab": false
           },
           "children": [
            {
             "mode": "normal",
             "text": "Craft Your Jewellery enquiry",
             "type": "text",
             "style": "",
             "detail": 0,
             "format": 0,
             "version": 1
            }
           ],
           "direction": "ltr",
           "format": "",
           "indent": 0
          },
          {
           "mode": "normal",
           "text": ".",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
    {
     "question": "Do you host events?",
     "answer": {
      "root": {
       "type": "root",
       "format": "",
       "indent": 0,
       "version": 1,
       "children": [
        {
         "type": "paragraph",
         "format": "",
         "indent": 0,
         "version": 1,
         "children": [
          {
           "mode": "normal",
           "text": "Yes. The museum hosts a calendar of events and masterclasses with artisans and historians throughout the year. Subscribe to our newsletter to hear about them first.",
           "type": "text",
           "style": "",
           "detail": 0,
           "format": 0,
           "version": 1
          }
         ],
         "direction": "ltr",
         "textStyle": "",
         "textFormat": 0
        }
       ],
       "direction": "ltr"
      }
     }
    },
