/**
 * Builds src/utilities/randomTextModel.ts, the letter-pair table that
 * src/utilities/randomText.ts uses to spot form answers made of random
 * letters ("Zzdgamua Jaqkn", city "Pnpbxoo").
 *
 * Developer-only, run by hand on a Mac (it reads macOS's word lists):
 *   node scripts/random-text-model/build.mts
 *   npx prettier --write src/utilities/randomTextModel.ts
 * Nothing at runtime reads these sources; only the generated table ships.
 *
 * Sources, with the weight each word counts for:
 *   /usr/share/dict/web2           235,976 English words        x1
 *   /usr/share/dict/propernames      1,308 first names          x20
 *   country names (Intl.DisplayNames, English)                  x20
 *   extra-words.txt (this folder): Indian first names and
 *   surnames, cities and states, occupations and enquiry words  x50
 *
 * Table: for each letter (plus start ^ and end $), log2 of the chance of
 * each next letter, with add-0.5 smoothing, rounded to 2 decimals.
 */
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const here = path.dirname(fileURLToPath(import.meta.url))
const out = path.resolve(here, '../../src/utilities/randomTextModel.ts')

const LETTERS = 'abcdefghijklmnopqrstuvwxyz'
const SIZE = 28 // a-z, then ^ (start) and $ (end)
const pos = (c: string): number => (c === '^' ? 26 : c === '$' ? 27 : LETTERS.indexOf(c))
const clean = (w: string): string =>
  w
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[^a-z]/g, '')

const readWords = (file: string): string[] =>
  fs
    .readFileSync(file, 'utf8')
    .split(/\s+/)
    .map(clean)
    .filter((w) => w.length > 1)

const regionNames = new Intl.DisplayNames(['en'], { type: 'region' })
const countryWords: string[] = []
for (let a = 65; a < 91; a++) {
  for (let b = 65; b < 91; b++) {
    const code = String.fromCharCode(a, b)
    try {
      const name = regionNames.of(code)
      if (name && name !== code) countryWords.push(...name.split(/[\s&,.()'-]+/).map(clean))
    } catch {
      // not a region code
    }
  }
}

const sources: Array<[string[], number]> = [
  [readWords('/usr/share/dict/web2'), 1],
  [readWords('/usr/share/dict/propernames'), 20],
  [countryWords.filter((w) => w.length > 1), 20],
  [readWords(path.join(here, 'extra-words.txt')), 50],
]

const counts = Array.from({ length: SIZE }, () => new Float64Array(SIZE))
for (const [words, weight] of sources) {
  for (const word of words) {
    const s = `^${word}$`
    for (let i = 0; i < s.length - 1; i++) counts[pos(s[i])][pos(s[i + 1])] += weight
  }
}
const table = counts.map((row) => {
  const total = row.reduce((x, y) => x + y, 0)
  return Array.from(row, (v) => Math.round(Math.log2((v + 0.5) / (total + 0.5 * SIZE)) * 100) / 100)
})

const body = table.map((row) => `  [${row.join(', ')}],`).join('\n')
fs.writeFileSync(
  out,
  `// GENERATED by scripts/random-text-model/build.mts. Do not edit by hand.
// For each letter a-z, then start (^) and end ($): log2 of the chance of
// each next letter (a-z, ^, $) in real words and names.
export const LETTER_PAIR_LOG2: readonly (readonly number[])[] = [
${body}
]
`,
)
console.log(`wrote ${path.relative(process.cwd(), out)}`)
